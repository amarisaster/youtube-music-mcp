[Unit]
Description=YouTube Music discovery facade for YouTube Music MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ytmusic-mcp
Group=ytmusic-mcp
WorkingDirectory=/opt/youtube-music-mcp/discovery
EnvironmentFile=/etc/youtube-music-mcp/discovery.env
ExecStart=/opt/youtube-music-mcp/discovery/.venv/bin/python server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
